# Copy this file outside the repository (or into the gitignored .local/) and
# pass it explicitly to bootstrap.sh/deploy.sh. Values below are fake.

# Deployment identity. Keep each customer production deployment in its own project.
# Custom domains use Cloud Run domain mappings, which exist only in asia-east1,
# asia-northeast1, asia-southeast1, europe-north1, europe-west1, europe-west4,
# us-central1, us-east1, us-east4, and us-west1. Pick the region from that list.
GCP_PROJECT_ID=praxis-example-staging
GCP_PROJECT_NUMBER=123456789012
GCP_REGION=europe-west4
CUSTOMER_ID=example
DEPLOYMENT_ENVIRONMENT=staging

# Images and Artifact Registry.
ARTIFACT_REGISTRY_REPOSITORY=praxis
API_IMAGE_NAME=praxis-api
WEB_IMAGE_NAME=praxis-web

# Cloud SQL. POSTGRES_18 matches docker-compose.yml and the current pgvector image.
CLOUD_SQL_INSTANCE=praxis-postgres
CLOUD_SQL_DATABASE_VERSION=POSTGRES_18
CLOUD_SQL_EDITION=ENTERPRISE
# db-f1-micro allows 25 connections (22 for application roles). The pool
# values further down fit the API and worker inside that limit; raise the tier
# before raising any pool size.
CLOUD_SQL_TIER=db-f1-micro
CLOUD_SQL_STORAGE_SIZE=10
CLOUD_SQL_STORAGE_TYPE=SSD
CLOUD_SQL_DATABASE=praxis
# Do not change the usernames - they are expected to receive certain permission scopes
CLOUD_SQL_MAINTENANCE_USER=praxis_admin
CLOUD_SQL_RUNTIME_USER=praxis_app
CLOUD_SQL_BACKUP_START_TIME=02:00
CLOUD_SQL_DELETION_PROTECTION=false
CLOUD_SQL_RETAIN_BACKUPS_ON_DELETE=false

# Storage. Prefix must be lowercase, end alphanumeric, and be at most 26 chars.
GCS_PUBLIC_ASSETS_BUCKET=praxis-example-staging-public-assets
WORKSPACE_BUCKET_PREFIX=praxis-example-staging
GCS_WORKSPACE_BUCKET_LOCATION=europe-west4
PUBLIC_ASSETS_BASE_URL=https://storage.googleapis.com/praxis-example-staging-public-assets

# Runtime identities. Never use the default Compute Engine service account.
API_SERVICE_ACCOUNT=praxis-api@praxis-example-staging.iam.gserviceaccount.com
WEB_SERVICE_ACCOUNT=praxis-web@praxis-example-staging.iam.gserviceaccount.com
WORKER_SERVICE_ACCOUNT=praxis-worker@praxis-example-staging.iam.gserviceaccount.com
MIGRATE_SERVICE_ACCOUNT=praxis-migrate@praxis-example-staging.iam.gserviceaccount.com

# Cloud Scheduler. Cloud Run's jobs.run API requires OAuth, not an OIDC token.
SCHEDULER_JOB_NAME=praxis-worker-minute
SCHEDULER_SCHEDULE="* * * * *"
SCHEDULER_TIME_ZONE=Etc/UTC

# Logging retention: 90 for staging, 400 for production.
LOG_RETENTION_DAYS=90

# Logical provider-resolved references are SHA-256 mapped by helpers.py exactly
# like apps/api/services/secrets/utils.py. Keep the two required names here.
ENCRYPTION_KEYS_SECRET_NAME=application-encryption-keys
CREDENTIAL_MASTER_KEY_SECRET_NAME=credential-master-key
PROVIDER_SECRET_LOGICAL_NAMES=application-encryption-keys,credential-master-key

# Direct Cloud Run secret bindings (ENV_NAME=physical-secret-id). Bootstrap
# seeds SECRET_KEY, METRICS_TOKEN, and both database URLs. Add provider-key
# versions before deploy.
# When OAuth is enabled, append each login or integration client-secret binding.
# Microsoft Graph bindings use forms such as
# OUTLOOK_MAIL_OAUTH_CLIENT_SECRET=praxis-outlook-mail-oauth-client-secret,
# OUTLOOK_CALENDAR_OAUTH_CLIENT_SECRET=praxis-outlook-calendar-oauth-client-secret,
# and SHAREPOINT_OAUTH_CLIENT_SECRET=praxis-sharepoint-oauth-client-secret.
# When login OAuth is enabled, append its client secret binding, for example
# GOOGLE_OAUTH_CLIENT_SECRET=praxis-google-oauth-client-secret.
# Integration providers listed in INTEGRATIONS_ENABLED_PROVIDERS read their
# OAuth client settings from the environment, so bind each value here as well
# (client IDs included), for example
# GOOGLE_ADS_OAUTH_CLIENT_ID=praxis-google-ads-oauth-client-id,GOOGLE_ADS_OAUTH_CLIENT_SECRET=praxis-google-ads-oauth-client-secret,GOOGLE_ADS_DEVELOPER_TOKEN=praxis-google-ads-developer-token.
DATABASE_MAINTENANCE_URL_SECRET_ID=praxis-database-maintenance-url
RUNTIME_SECRET_BINDINGS=SECRET_KEY=praxis-secret-key,DATABASE_URL=praxis-database-url,DATABASE_MAINTENANCE_URL=praxis-database-maintenance-url,METRICS_TOKEN=praxis-metrics-token,OPENAI_API_KEY=praxis-openai-api-key,ANTHROPIC_API_KEY=praxis-anthropic-api-key,GOOGLE_API_KEY=praxis-google-api-key

# Route Google models and embeddings through Vertex AI on GCP_PROJECT_ID.
# When enabled, GOOGLE_API_KEY is unnecessary for Google model usage and can
# be removed from RUNTIME_SECRET_BINDINGS.
GOOGLE_VERTEX_AI=false
# Auto: Gemini Flash/Flash-Lite eu, Pro global; embeddings global.
# Explicit locations override auto and must be supported by the selected model.
GOOGLE_VERTEX_LOCATION=auto
# Claude and partner models use ADC on GCP_PROJECT_ID. Enable each selected
# serverless model in Model Garden first. Locations depend on the model.
ANTHROPIC_VERTEX_AI=false
ANTHROPIC_VERTEX_LOCATION=global
VERTEX_PARTNER_MODELS_ENABLED=false
# Model defaults: Meta us-east5, Grok global, Mistral Small europe-west4.
# Meta and Grok have no supported European regional endpoint.
# Optional override: {"mistral:mistral-small-2503":"us-central1"}
# Remove the legacy VERTEX_PARTNER_LOCATION setting.
VERTEX_PARTNER_MODEL_LOCATIONS='{}'

# Bindings (by env name) the migrate job also mounts. Settings validation needs
# these at import; LLM provider keys are deliberately excluded from migrate.
MIGRATE_SECRET_ENV_NAMES=SECRET_KEY,DATABASE_URL,DATABASE_MAINTENANCE_URL,METRICS_TOKEN

# Public application configuration.
APP_BASE_URL=https://api.example.invalid
VITE_API_BASE_URL=https://api.example.invalid/api/v1
FRONTEND_URL=https://app.example.invalid
ALLOWED_CORS_ORIGINS=https://app.example.invalid
COOKIE_DOMAIN=.example.invalid
ARTIFACT_ORIGIN=https://artifacts.example.invalid
ARTIFACT_SHARING_ENABLED=false
ALLOW_SIGNUP=true
SUPER_ADMIN_EMAILS=admin@example.invalid
ALLOW_WORKSPACE_CREATION=true
EMAIL_AUTH_ENABLED=true
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=disabled
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.invalid/oauth/callback
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=disabled
GITHUB_OAUTH_REDIRECT_URI=https://app.example.invalid/oauth/callback
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_OAUTH_CLIENT_ID=disabled
MICROSOFT_OAUTH_REDIRECT_URI=https://app.example.invalid/oauth/callback
EMAIL_PROVIDER=disabled
EMAIL_ENABLED=false
EMAIL_REPLY_TO=noreply@example.invalid
INTEGRATIONS_ENABLED_PROVIDERS=[]
INTEGRATIONS_OAUTH_REDIRECT_URI=https://app.example.invalid/integrations/oauth/callback
NOTION_OAUTH_CLIENT_ID=disabled
MICROSOFT_GRAPH_TENANT=organizations
MICROSOFT_GRAPH_REQUESTS_PER_SECOND=4.0
OUTLOOK_MAIL_OAUTH_CLIENT_ID=disabled
OUTLOOK_MAIL_OAUTH_TENANT=
OUTLOOK_CALENDAR_OAUTH_CLIENT_ID=disabled
OUTLOOK_CALENDAR_OAUTH_TENANT=
SHAREPOINT_OAUTH_CLIENT_ID=disabled
SHAREPOINT_OAUTH_TENANT=
SHAREPOINT_DISCOVERY_MAX_SITES=50
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-5.6-luna
CONVERSATION_NAMING_PROVIDER=openai
CONVERSATION_NAMING_MODEL=gpt-5.6-luna
AGENT_HISTORY_SUMMARY_MODEL_PROVIDER=openai
AGENT_HISTORY_SUMMARY_MODEL=gpt-5.6-luna
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1024
KB_ANNOTATION_PROVIDER=openai
KB_ANNOTATION_MODEL=gpt-5.6-luna
METRICS_ENABLED=false
# Cloud Run proxies every request from a link-local address and Google front
# ends append the caller to X-Forwarded-For. Trust all of those ranges so rate
# limits and audit rows record real client addresses.
TRUSTED_PROXY_CIDRS=169.254.0.0/16,130.211.0.0/22,35.191.0.0/16
AUDIT_EVENTS_RETENTION_DAYS=90
SECURITY_EVENTS_RETENTION_DAYS=90
AGENT_RUN_APPROVAL_EXPIRY_DAYS=14
# Each API or worker process can open runtime + maintenance + usage pool
# connections: 7 + 3 + 1 = 11 here, so both together stay within the 22 that
# db-f1-micro grants application roles. WORKER_MAX_CONCURRENT_RUNS must not
# exceed the smaller runtime or maintenance pool capacity minus one, and
# AGENT_RUN_MAX_CONCURRENT_TURNS must not exceed runtime capacity minus four.
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=3
DB_MAINTENANCE_POOL_SIZE=1
DB_MAINTENANCE_POOL_MAX_OVERFLOW=2
AI_USAGE_DB_POOL_SIZE=1
AGENT_RUN_MAX_CONCURRENT_TURNS=3

# Cloud Run sizing and worker drain budget. Job timeout includes shutdown headroom.
API_CPU=1
API_MEMORY=1Gi
WEB_CPU=1
WEB_MEMORY=512Mi
JOB_CPU=1
JOB_MEMORY=1Gi
WORKER_DRAIN_MAX_SECONDS=300
WORKER_TASK_TIMEOUT_SECONDS=390
WORKER_MAX_CONCURRENT_RUNS=2
WORKER_MAX_RETRIES=0

# Web image security-header build inputs.
WEB_PUBLIC_ASSET_ORIGINS=https://storage.googleapis.com
WEB_HTTPS_ONLY=true
