apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: praxis-worker
  namespace: "${GCP_PROJECT_NUMBER}"
  labels:
    cloud.googleapis.com/location: ${GCP_REGION}
spec:
  template:
    metadata:
      annotations:
        run.googleapis.com/cloudsql-instances: ${CLOUD_SQL_CONNECTION_NAME}
        run.googleapis.com/secrets: '${RUNTIME_SECRET_ANNOTATION}'
    spec:
      parallelism: 1
      taskCount: 1
      template:
        spec:
          maxRetries: ${WORKER_MAX_RETRIES}
          timeoutSeconds: ${WORKER_TASK_TIMEOUT_SECONDS}
          serviceAccountName: ${WORKER_SERVICE_ACCOUNT}
          containers:
            - image: ${API_IMAGE}
              command:
                - python
              args:
                - -m
                - workers.main
              resources:
                limits:
                  cpu: "${JOB_CPU}"
                  memory: ${JOB_MEMORY}
              env:
                - name: ENVIRONMENT
                  value: ${DEPLOYMENT_ENVIRONMENT}
                - name: DEBUG
                  value: "false"
                - name: SQL_DEBUG
                  value: "false"
                - name: CLOUD_PROVIDER
                  value: gcp
                - name: SECRET_PROVIDER
                  value: gcp_secret_manager
                - name: STORAGE_PROVIDER
                  value: gcs
                - name: GCP_PROJECT_ID
                  value: ${GCP_PROJECT_ID}
                - name: GOOGLE_VERTEX_AI
                  value: "${GOOGLE_VERTEX_AI}"
                - name: GOOGLE_VERTEX_LOCATION
                  value: ${GOOGLE_VERTEX_LOCATION}
                - name: ANTHROPIC_VERTEX_AI
                  value: "${ANTHROPIC_VERTEX_AI}"
                - name: ANTHROPIC_VERTEX_LOCATION
                  value: "${ANTHROPIC_VERTEX_LOCATION}"
                - name: VERTEX_PARTNER_MODELS_ENABLED
                  value: "${VERTEX_PARTNER_MODELS_ENABLED}"
                - name: VERTEX_PARTNER_MODEL_LOCATIONS
                  value: ${VERTEX_PARTNER_MODEL_LOCATIONS_YAML}
                - name: GCS_PUBLIC_ASSETS_BUCKET
                  value: ${GCS_PUBLIC_ASSETS_BUCKET}
                - name: GCS_WORKSPACE_BUCKET_LOCATION
                  value: ${GCS_WORKSPACE_BUCKET_LOCATION}
                - name: WORKSPACE_BUCKET_PREFIX
                  value: ${WORKSPACE_BUCKET_PREFIX}
                - name: PUBLIC_ASSETS_BASE_URL
                  value: ${PUBLIC_ASSETS_BASE_URL}
                - name: APP_BASE_URL
                  value: ${APP_BASE_URL}
                - name: FRONTEND_URL
                  value: ${FRONTEND_URL}
                - name: ALLOWED_CORS_ORIGINS
                  value: ${ALLOWED_CORS_ORIGINS}
                - name: SECURE_COOKIES
                  value: "true"
                - name: COOKIE_DOMAIN
                  value: ${COOKIE_DOMAIN}
                - name: ARTIFACT_ORIGIN
                  value: ${ARTIFACT_ORIGIN}
                - name: ARTIFACT_SHARING_ENABLED
                  value: "${ARTIFACT_SHARING_ENABLED}"
                - name: ALLOW_SIGNUP
                  value: "${ALLOW_SIGNUP}"
                - name: ALLOW_WORKSPACE_CREATION
                  value: "${ALLOW_WORKSPACE_CREATION}"
                - name: EMAIL_PROVIDER
                  value: ${EMAIL_PROVIDER}
                - name: EMAIL_ENABLED
                  value: "${EMAIL_ENABLED}"
                - name: EMAIL_REPLY_TO
                  value: ${EMAIL_REPLY_TO}
                - name: INTEGRATIONS_ENABLED_PROVIDERS
                  value: '${INTEGRATIONS_ENABLED_PROVIDERS}'
                - name: INTEGRATIONS_OAUTH_REDIRECT_URI
                  value: ${INTEGRATIONS_OAUTH_REDIRECT_URI}
                - name: MICROSOFT_GRAPH_TENANT
                  value: ${MICROSOFT_GRAPH_TENANT}
                - name: MICROSOFT_GRAPH_REQUESTS_PER_SECOND
                  value: "${MICROSOFT_GRAPH_REQUESTS_PER_SECOND}"
                - name: OUTLOOK_MAIL_OAUTH_CLIENT_ID
                  value: ${OUTLOOK_MAIL_OAUTH_CLIENT_ID}
                - name: OUTLOOK_MAIL_OAUTH_TENANT
                  value: ${OUTLOOK_MAIL_OAUTH_TENANT}
                - name: OUTLOOK_CALENDAR_OAUTH_CLIENT_ID
                  value: ${OUTLOOK_CALENDAR_OAUTH_CLIENT_ID}
                - name: OUTLOOK_CALENDAR_OAUTH_TENANT
                  value: ${OUTLOOK_CALENDAR_OAUTH_TENANT}
                - name: SHAREPOINT_OAUTH_CLIENT_ID
                  value: ${SHAREPOINT_OAUTH_CLIENT_ID}
                - name: SHAREPOINT_OAUTH_TENANT
                  value: ${SHAREPOINT_OAUTH_TENANT}
                - name: SHAREPOINT_DISCOVERY_MAX_SITES
                  value: "${SHAREPOINT_DISCOVERY_MAX_SITES}"
                - name: ENCRYPTION_KEYS_SECRET_NAME
                  value: ${ENCRYPTION_KEYS_SECRET_NAME}
                - name: CREDENTIAL_MASTER_KEY_SECRET_NAME
                  value: ${CREDENTIAL_MASTER_KEY_SECRET_NAME}
                - name: DEFAULT_MODEL_PROVIDER
                  value: ${DEFAULT_MODEL_PROVIDER}
                - name: DEFAULT_MODEL
                  value: ${DEFAULT_MODEL}
                - name: CONVERSATION_NAMING_PROVIDER
                  value: ${CONVERSATION_NAMING_PROVIDER}
                - name: CONVERSATION_NAMING_MODEL
                  value: ${CONVERSATION_NAMING_MODEL}
                - name: AGENT_HISTORY_SUMMARY_MODEL_PROVIDER
                  value: ${AGENT_HISTORY_SUMMARY_MODEL_PROVIDER}
                - name: AGENT_HISTORY_SUMMARY_MODEL
                  value: ${AGENT_HISTORY_SUMMARY_MODEL}
                - name: KB_ANNOTATION_PROVIDER
                  value: "${KB_ANNOTATION_PROVIDER}"
                - name: KB_ANNOTATION_MODEL
                  value: "${KB_ANNOTATION_MODEL}"
                - name: EMBEDDINGS_PROVIDER
                  value: ${EMBEDDINGS_PROVIDER}
                - name: EMBEDDINGS_MODEL
                  value: ${EMBEDDINGS_MODEL}
                - name: EMBEDDINGS_DIMENSIONS
                  value: "${EMBEDDINGS_DIMENSIONS}"
                - name: METRICS_ENABLED
                  value: "${METRICS_ENABLED}"
                - name: TRUSTED_PROXY_CIDRS
                  value: ${TRUSTED_PROXY_CIDRS}
                - name: AUDIT_EVENTS_RETENTION_DAYS
                  value: "${AUDIT_EVENTS_RETENTION_DAYS}"
                - name: SECURITY_EVENTS_RETENTION_DAYS
                  value: "${SECURITY_EVENTS_RETENTION_DAYS}"
                - name: AGENT_RUN_APPROVAL_EXPIRY_DAYS
                  value: "${AGENT_RUN_APPROVAL_EXPIRY_DAYS}"
                - name: WORKER_MODE
                  value: drain
                - name: DB_POOL_SIZE
                  value: "${DB_POOL_SIZE}"
                - name: DB_POOL_MAX_OVERFLOW
                  value: "${DB_POOL_MAX_OVERFLOW}"
                - name: DB_MAINTENANCE_POOL_SIZE
                  value: "${DB_MAINTENANCE_POOL_SIZE}"
                - name: DB_MAINTENANCE_POOL_MAX_OVERFLOW
                  value: "${DB_MAINTENANCE_POOL_MAX_OVERFLOW}"
                - name: AI_USAGE_DB_POOL_SIZE
                  value: "${AI_USAGE_DB_POOL_SIZE}"
                - name: AGENT_RUN_MAX_CONCURRENT_TURNS
                  value: "${AGENT_RUN_MAX_CONCURRENT_TURNS}"
                - name: WORKER_DRAIN_MAX_SECONDS
                  value: "${WORKER_DRAIN_MAX_SECONDS}"
                - name: WORKER_MAX_CONCURRENT_RUNS
                  value: "${WORKER_MAX_CONCURRENT_RUNS}"
${RUNTIME_SECRET_ENV_YAML}
