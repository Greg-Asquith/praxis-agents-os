# deploy/gcp/services/praxis-data-science.yaml.tmpl
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: praxis-data-science
  namespace: "${GCP_PROJECT_NUMBER}"
  labels:
    cloud.googleapis.com/location: ${GCP_REGION}
  annotations:
    # The deployment has no VPC, so internal ingress would block the API. Invoker
    # IAM stays on: only the API and worker identities hold run.invoker.
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "${DATA_SCIENCE_MAX_INSTANCES}"
        run.googleapis.com/cpu-throttling: "true"
        run.googleapis.com/execution-environment: gen2
        # Start-up imports PyTorch and runs one forecast before serving.
        run.googleapis.com/startup-cpu-boost: "true"
    spec:
      # One forecast per instance: the child process owns the CPU and memory.
      containerConcurrency: 1
      timeoutSeconds: ${DATA_SCIENCE_REQUEST_TIMEOUT_SECONDS}
      # A dedicated identity with no IAM roles, secrets, or database access.
      serviceAccountName: ${DATA_SCIENCE_SERVICE_ACCOUNT}
      containers:
        - name: praxis-data-science
          image: ${DATA_SCIENCE_IMAGE}
          ports:
            - name: http1
              containerPort: 8080
          resources:
            limits:
              cpu: "${DATA_SCIENCE_CPU}"
              memory: ${DATA_SCIENCE_MEMORY}
          # No RENDERER_ALLOWED_URL_PREFIXES: data travels inline and no URL is fetchable.
          env:
            - name: RENDERER_MAX_TIMEOUT_SECONDS
              value: "${DATA_SCIENCE_TIMEOUT_SECONDS}"
            - name: RENDERER_CHILD_MEMORY_BYTES
              value: "${DATA_SCIENCE_CHILD_MEMORY_BYTES}"
          startupProbe:
            httpGet:
              path: /healthz
              port: 8080
            timeoutSeconds: 5
            failureThreshold: 24
            periodSeconds: 5
  traffic:
    - percent: 100
      latestRevision: true
