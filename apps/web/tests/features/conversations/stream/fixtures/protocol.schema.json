    "workflow.state": {
      "$defs": {
        "WorkflowState": {
          "enum": [
            "started",
            "completed",
            "failed"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "error_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Excerpt"
        },
        "output_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Excerpt"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/WorkflowState"
