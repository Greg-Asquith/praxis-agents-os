    "agent_run_statuses": [
      "pending",
      "running",
      "awaiting_approval",
      "completed",
      "failed",
      "cancelled"
    ],
    "conversation_sources": [
      "direct",
      "scheduled",
      "delegated",
      "event"
    ],
    "message_channels": [
      "text",
      "thinking"
    ],
    "stream_run_statuses": [
      "pending",
      "running",
      "awaiting_approval",
      "completed",
      "failed",
      "cancelled",
      "queued"
    ],
    "workflow_states": [
      "started",
      "completed",
      "failed"
    ]
  },
  "event_names": [
    "conversation.created",
    "conversation.updated",
    "run.status",
    "message.start",
    "message.delta",
    "message.end",
    "tool.call",
    "tool.result",
    "tool.approval_required",
    "workflow.state",
    "error",
