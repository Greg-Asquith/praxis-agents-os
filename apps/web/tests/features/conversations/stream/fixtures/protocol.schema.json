    "tool.approval_required": {
      "$defs": {
        "PendingDelegatedApprovalRead": {
          "properties": {
            "child_agent_id": {
              "format": "uuid",
              "title": "Child Agent Id",
              "type": "string"
            },
            "child_agent_name": {
              "title": "Child Agent Name",
              "type": "string"
            },
            "child_conversation_id": {
              "format": "uuid",
              "title": "Child Conversation Id",
              "type": "string"
            },
            "child_run_id": {
              "format": "uuid",
              "title": "Child Run Id",
              "type": "string"
            },
            "parent_tool_call_id": {
              "title": "Parent Tool Call Id",
              "type": "string"
            },
            "pending_approval_count": {
              "minimum": 0,
              "title": "Pending Approval Count",
              "type": "integer"
            }
          },
          "required": [
            "parent_tool_call_id",
            "child_agent_id",
            "child_agent_name",
            "child_conversation_id",
            "child_run_id",
            "pending_approval_count"
          ],
          "title": "PendingDelegatedApprovalRead",
          "type": "object"
        },
        "TaintSource": {
          "additionalProperties": false,
          "properties": {
            "source_kind": {
              "minLength": 1,
              "title": "Source Kind",
              "type": "string"
            },
            "source_ref": {
              "minLength": 1,
              "title": "Source Ref",
              "type": "string"
