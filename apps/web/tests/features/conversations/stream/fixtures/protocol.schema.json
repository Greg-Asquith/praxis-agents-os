            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            },
            "last_message_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last Message At"
            },
            "metadata": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Metadata"
            },
            "needs_approval": {
              "default": false,
              "title": "Needs Approval",
              "type": "boolean"
            },
            "source": {
              "$ref": "#/$defs/ConversationSource"
