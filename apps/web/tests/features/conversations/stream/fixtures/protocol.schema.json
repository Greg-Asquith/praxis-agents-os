        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "conversation_id",
        "seq",
        "tool_call_id",
        "state"
      ],
      "title": "WorkflowStateEvent",
      "type": "object"
    }
