    "message.start": {
      "$defs": {
        "MessageChannel": {
          "enum": [
            "text",
            "thinking"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/MessageChannel"
        },
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "role": {
          "const": "assistant",
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "conversation_id",
        "seq",
        "message_id",
        "role",
        "channel"
      ],
      "title": "MessageStartEvent",
      "type": "object"
    },
    "run.status": {
      "$defs": {
        "RunStatus": {
          "enum": [
            "pending",
            "running",
            "awaiting_approval",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "RunStatus",
          "type": "string"
        },
        "StreamRunStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "const": "queued",
              "type": "string"
