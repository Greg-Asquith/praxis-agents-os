        "delegation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingDelegatedApprovalRead"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derived_from_untrusted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Untrusted"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_tool_call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tool Call Id"
        },
        "replay_args": {
          "default": null,
          "title": "Replay Args"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "taint_sources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TaintSource"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taint Sources"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "conversation_id",
        "seq",
        "tool_call_id",
        "name",
        "args"
      ],
      "title": "ToolApprovalRequiredEvent",
      "type": "object"
    },
    "tool.call": {
      "additionalProperties": false,
      "properties": {
        "args": {
