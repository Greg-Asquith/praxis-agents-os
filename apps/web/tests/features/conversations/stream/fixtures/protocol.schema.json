          "required": [
            "id",
            "user_id",
            "workspace_id",
            "created_by",
            "title",
            "description",
            "status",
            "metadata",
            "unread",
            "source",
            "last_message_at",
            "active_agent_id",
            "agent_slug",
            "created_at",
            "updated_at"
