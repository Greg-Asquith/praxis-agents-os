          "type": "object"
        },
        "ConversationSource": {
          "enum": [
            "direct",
            "scheduled",
            "delegated",
            "event"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "conversation": {
          "$ref": "#/$defs/ConversationRead"
        },
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "conversation_id",
        "seq",
        "conversation"
      ],
      "title": "ConversationCreatedEvent",
      "type": "object"
    },
