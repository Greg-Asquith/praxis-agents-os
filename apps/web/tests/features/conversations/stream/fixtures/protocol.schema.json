          "type": "object"
        },
        "ConversationSource": {
          "enum": [
            "direct",
            "scheduled",
            "delegated",
            "event"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "conversation": {
          "$ref": "#/$defs/ConversationRead"
