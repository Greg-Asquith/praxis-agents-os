    "tool.result": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "parent_tool_call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tool Call Id"
        },
        "result": {
          "title": "Result"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "tool_call_id": {
          "minLength": 1,
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "conversation_id",
        "seq",
        "tool_call_id",
        "name",
        "result"
      ],
      "title": "ToolResultEvent",
      "type": "object"
