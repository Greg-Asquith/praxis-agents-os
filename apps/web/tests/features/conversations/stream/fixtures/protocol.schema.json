              "title": "Title"
            },
            "unread": {
              "title": "Unread",
              "type": "boolean"
            },
            "updated_at": {
              "format": "date-time",
              "title": "Updated At",
              "type": "string"
            },
            "user_id": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            },
            "workspace_id": {
              "format": "uuid",
              "title": "Workspace Id",
              "type": "string"
            }
