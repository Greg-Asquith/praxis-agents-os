                },
                {
                  "type": "null"
                }
              ],
              "title": "Active Agent Id"
            },
            "active_run_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Active Run Id"
            },
            "active_run_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Active Run Status"
            },
            "agent_name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
