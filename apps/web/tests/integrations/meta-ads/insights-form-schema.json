    "since": {
      "title": "Since",
      "type": "string"
    },
    "until": {
      "title": "Until",
      "type": "string"
    },
    "level": {
      "enum": ["account", "campaign", "adset", "ad"],
      "type": "string",
      "$ref": "#/$defs/MetaAdsInsightsLevel",
      "default": "campaign"
    },
    "breakdowns": {
      "items": {
        "type": "string",
        "enum": [
          "age",
          "country",
          "device_platform",
          "gender",
          "impression_device",
          "platform_position",
          "publisher_platform",
          "region"
        ]
      },
      "maxItems": 3,
      "title": "Breakdowns",
      "type": "array"
    },
    "action_breakdowns": {
      "items": {
        "type": "string",
        "enum": ["action_destination", "action_device", "action_type"]
      },
      "maxItems": 3,
      "title": "Action Breakdowns",
      "type": "array"
    },
    "attribution_windows": {
      "anyOf": [
        {
          "items": {
            "type": "string",
            "enum": ["1d_click", "1d_ev", "1d_view", "28d_click", "7d_click"]
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution Windows"
    },
    "time_increment": {
      "anyOf": [
        {
          "enum": ["all_days", "monthly"],
          "type": "string"
        },
        {
          "maximum": 90,
          "minimum": 1,
          "type": "integer"
        }
      ],
      "default": "all_days",
      "title": "Time Increment"
    },
    "filters": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MetaAdsInsightsFilter"
          },
          "maxItems": 10,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filters"
    },
    "sort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sort",
      "x-directions": ["ascending", "descending"]
    },
    "limit": {
      "default": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer",
      "maximum": 1000
    }
  },
  "required": ["fields", "since", "until"],
  "title": "MetaAdsInsightsInput",
  "type": "object"
}
