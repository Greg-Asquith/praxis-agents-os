{
  "$defs": {
    "MetaAdsFilterOperator": {
      "enum": [
        "EQUAL",
        "NOT_EQUAL",
        "IN",
        "NOT_IN",
        "CONTAIN",
        "NOT_CONTAIN",
        "GREATER_THAN",
        "LESS_THAN"
      ],
      "type": "string"
    },
    "MetaAdsFilterScalar": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ]
    },
    "MetaAdsInsightsFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string",
          "examples": [
            "ad.effective_status",
            "ad.id",
            "ad.name",
            "adset.effective_status",
            "adset.id",
            "adset.name",
            "campaign.effective_status",
            "campaign.id",
            "campaign.name"
          ]
        },
        "operator": {
          "$ref": "#/$defs/MetaAdsFilterOperator",
          "x-value-kinds": {
            "EQUAL": "scalar",
            "NOT_EQUAL": "scalar",
            "IN": "list",
            "NOT_IN": "list",
            "CONTAIN": "text",
            "NOT_CONTAIN": "text",
            "GREATER_THAN": "number",
            "LESS_THAN": "number"
          }
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetaAdsFilterScalar"
            },
            {
              "items": {
                "$ref": "#/$defs/MetaAdsFilterScalar"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": ["field", "operator", "value"],
      "title": "MetaAdsInsightsFilter",
      "type": "object"
    },
    "MetaAdsInsightsLevel": {
      "enum": ["account", "campaign", "adset", "ad"],
      "type": "string"
    }
  },
